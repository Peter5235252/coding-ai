# No Gemini API key belongs in this file.
#
# The app asks for a key in its setup screen and stores it encrypted at rest:
#   ~/.config/zenith-code/api-key.vault  (AES-256-GCM, mode 0600)
#   ~/.config/zenith-code/master.key     (32-byte local key, mode 0600)
#
# Optional server settings:
# PORT=3000
# HOST=127.0.0.1
# ZENITH_CONFIG_DIR=/custom/path/to/zenith-code
# ZENITH_MASTER_KEY=<base64-encoded 32-byte key>   # keeps the master key off disk
# ZENITH_ALLOWED_HOSTS=my-host.local,192.168.1.20  # extra Host headers for remote use

# APP_URL: The URL where this applet is hosted.
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Sandbox Code Execution Backends (Approach 2)
# Set PISTON_API_URL to your self-hosted Piston /api/v2/piston/execute endpoint for production isolation & full stdin piping.
# Leave unset to use the default public Codapi sandbox (https://api.codapi.org/v1/exec) for compiled languages.
PISTON_API_URL=""
CODAPI_API_URL=""

